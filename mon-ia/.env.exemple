# Réglages de ton IA. Pour les modifier, copie ce fichier en « .env » puis enlève le « # »
# devant les lignes que tu veux changer. Tout est facultatif.

# Le nom de ton IA au premier lancement (ensuite, change-le depuis l'interface).
# IA_NOM=Nova

# Le modèle utilisé par défaut (voir le README pour choisir selon ton ordinateur).
# IA_MODELE=qwen3:8b

# La « mémoire de travail » du modèle, en tokens. Plus grand = conversations et documents
# plus longs, mais plus de mémoire vive utilisée. 8192 convient à la plupart des ordinateurs ;
# essaie 16384 ou 32768 si ta machine a beaucoup de mémoire.
# IA_CONTEXTE=8192

# Réflexion approfondie activée par défaut (oui / non).
# IA_REFLEXION=non

# Recherche sur internet (oui / non). Mets « non » pour une IA 100 % hors ligne.
# IA_RECHERCHE_WEB=oui
# IA_REGION_RECHERCHE=fr-fr

# Dossier où sont rangées les conversations, la mémoire et la personnalité.
# IA_DONNEES=data

# Adresse de l'interface web. Avec 127.0.0.1, elle n'est accessible que depuis ton ordinateur.
# IA_HOTE=127.0.0.1
# IA_PORT=8000

# Adresse d'Ollama, si tu le fais tourner sur un autre ordinateur de ton réseau.
# OLLAMA_HOST=http://127.0.0.1:11434
